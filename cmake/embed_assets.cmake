# The kit's default look (assets/README.md) as bytes in a C++ file, so a game ships no files for it: run at configure
# time, the file rewritten only when its text changes (no rebuild otherwise).
#   rekit_embed_assets(<out.cpp> <symbol> <file> [<symbol> <file> ...])
# Each <symbol> becomes `rekit::sdl::detail::Asset <symbol>()` (src/sdl/kit_assets.h).
function(rekit_embed_assets out)
  set(text "// Made by cmake/embed_assets.cmake from assets/: do not edit.\n#include \"kit_assets.h\"\n\nnamespace rekit::sdl::detail {\nnamespace {\n")
  set(funcs "")
  set(args ${ARGN})
  list(LENGTH args n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET args ${i} symbol)
    list(GET args ${j} file)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" hex HEX)
    file(SIZE "${file}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" hex "${hex}")
    string(APPEND text "const unsigned char k_${symbol}[] = {\n${hex}\n};\n")
    string(APPEND funcs "Asset ${symbol}() { return {k_${symbol}, ${size}}; }\n")
  endforeach()
  string(APPEND text "}  // namespace\n\n${funcs}\n}  // namespace rekit::sdl::detail\n")
  file(WRITE "${out}.tmp" "${text}")
  configure_file("${out}.tmp" "${out}" COPYONLY)
endfunction()
